# Environment Configuration for Cyclone Monitoring & Prediction System

# 1. MOSDAC (ISRO SAC) Credentials
# Register at: https://mosdac.gov.in/
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password

# 2. India Meteorological Department (IMD) API Access
# Register at: https://api.imd.gov.in/public/
IMD_API_KEY=your_imd_api_key

# 3. Copernicus Climate Data Store (CDS / ERA5 Reanalysis)
# Register at: https://cds.climate.copernicus.eu/
CDS_API_KEY=your_cds_api_key
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# 4. Telegram Alert Bot (Optional for Phase 7)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# 5. Database Configuration (Optional for Phase 5+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyclone_db
REDIS_URL=redis://localhost:6379/0
